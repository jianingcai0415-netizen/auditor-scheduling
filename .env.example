# Copy this file to .env, paste the key locally, then restart the backend.
# .env is ignored by Git; never commit or share the real key.
DISPATCH_AI_ENABLED=true
DISPATCH_AI_PROVIDER=deepseek
DISPATCH_AI_API_KEY=
DISPATCH_AI_MODEL=deepseek-chat
DISPATCH_AI_BASE_URL=https://api.deepseek.com
DISPATCH_AI_TIMEOUT_SECONDS=120
# Auto-computed real driving time between sites (Amap Web Service). Leave empty to fall back
# to the straight-line estimate. Apply for a key at https://lbs.amap.com (service: Web服务).
AMAP_API_KEY=
# Sample dataset: written only into a brand-new database (no structures yet). Comment it out
# or set false to start from an empty database instead.
APP_DEMO_DATA=true
# AUTH_SESSION_KEY is auto-generated on first launch (48 random chars); never edit or share .env
